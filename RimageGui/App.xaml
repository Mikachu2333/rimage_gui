<Application x:Class="RimageGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    The active palette is inserted ahead of this at startup by
                    ThemeManager. Merged dictionaries resolve last-to-first, so
                    Styles.xaml keeps priority for its own keys while its
                    DynamicResource colour lookups fall through to the palette
                    and re-resolve whenever that palette is swapped.
                -->
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
