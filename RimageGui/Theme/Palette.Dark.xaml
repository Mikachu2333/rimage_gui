<!--
    Dark palette. Mirrors every key in Palette.Light.xaml; see the note there.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PanelBackground" Color="#272727" />
    <SolidColorBrush x:Key="Divider" Color="#3A3A3A" />

    <!-- controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#383838" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#434343" />
    <SolidColorBrush x:Key="ControlBackgroundDisabled" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlBorder" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ControlBorderHover" Color="#585858" />
    <SolidColorBrush x:Key="FocusBorder" Color="#ABABAB" />

    <!-- text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#ABABAB" />
    <SolidColorBrush x:Key="TextDisabled" Color="#6E6E6E" />

    <!-- accent -->
    <SolidColorBrush x:Key="AccentBackground" Color="#EDEDED" />
    <SolidColorBrush x:Key="AccentBackgroundHover" Color="#ABABAB" />
    <SolidColorBrush x:Key="AccentBackgroundPressed" Color="#6E6E6E" />
    <SolidColorBrush x:Key="AccentForeground" Color="#0A1B26" />

    <!-- file table -->
    <SolidColorBrush x:Key="ListBackground" Color="#252525" />
    <SolidColorBrush x:Key="ListRowHover" Color="#2F3B44" />
    <SolidColorBrush x:Key="ListRowSelected" Color="#0E4A72" />
    <SolidColorBrush x:Key="ListRowSelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#2A2A2A" />

    <!-- log + progress -->
    <SolidColorBrush x:Key="LogBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ProgressFill" Color="#4CC2FF" />

    <!-- semantic status -->
    <SolidColorBrush x:Key="StatusDone" Color="#6CCB5F" />
    <SolidColorBrush x:Key="StatusFailed" Color="#FF99A4" />
    <SolidColorBrush x:Key="StatusMuted" Color="#9A9A9A" />

    <!-- popups -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ToolTipBorder" Color="#454545" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#6A6A6A" />

</ResourceDictionary>
