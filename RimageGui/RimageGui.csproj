<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RimageGui</RootNamespace>
    <AssemblyName>rimage-gui</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.0.2</Version>
    <Product>Rimage GUI</Product>
    <Company>Mikachu2333</Company>
    <Copyright>MIT</Copyright>
    <!-- Satellite assemblies are not used; strings live in a compiled catalog. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The rimage backend is embedded per-architecture. It is ~25 MB (x64) / ~20 MB
    (x86), so embedding both into one assembly is never done. Release builds must
    pick an explicit platform; AnyCPU and Debug fall back to reading the backend
    from the repository's res/ directory, which keeps inner-loop builds fast.
  -->
  <PropertyGroup>
    <EmbedBackend Condition="'$(EmbedBackend)' == '' And '$(Configuration)' == 'Release' And ('$(Platform)' == 'x64' Or '$(Platform)' == 'x86')">true</EmbedBackend>
    <EmbedBackend Condition="'$(EmbedBackend)' == ''">false</EmbedBackend>
    <DefineConstants Condition="'$(EmbedBackend)' == 'true'">$(DefineConstants);EMBED_BACKEND</DefineConstants>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedBackend)' == 'true' And '$(Platform)' == 'x64'">
    <EmbeddedResource Include="..\res\rimage_x64.exe" LogicalName="RimageGui.rimage.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(EmbedBackend)' == 'true' And '$(Platform)' == 'x86'">
    <EmbeddedResource Include="..\res\rimage_x86.exe" LogicalName="RimageGui.rimage.exe" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- DataContractJsonSerializer, used to read the rimage metadata output.
         Microsoft.Win32.SystemEvents lives in System.dll on .NET Framework, so
         following live theme switches needs no extra reference. -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
