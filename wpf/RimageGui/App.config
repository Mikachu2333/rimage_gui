<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      WPF only honours the manifest's PerMonitorV2 declaration when this switch
      is off; without it the window renders blurry after moving between monitors
      with different scale factors. .NET Framework 4.6.2+ only.
    -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
