<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The test project deliberately keeps underscore-separated method names
         and local array literals; those rules add noise without safety value. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1825;CA1859</NoWarn>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <!-- The main project is a WinExe; tests reference its types directly. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- JobRunnerTests draws its own sample bitmap. -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimageGui\RimageGui.csproj" />
  </ItemGroup>

</Project>
